# --- Script writer ---
# gemini (default, uses GEMINI_API_KEY below) | claude
SCRIPT_PROVIDER=gemini
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# Only if SCRIPT_PROVIDER=claude:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Voice ---
# gemini (default) | elevenlabs | espeak (offline robot voice, testing only)
TTS_PROVIDER=gemini

# Google Gemini TTS — key from aistudio.google.com
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Upbeat/youthful voices: Puck, Leda, Sadachbia, Laomedeia, Fenrir
GEMINI_VOICE=Puck
# GEMINI_STYLE=bright, bouncy and playful, like a cheerful cartoon character talking to little kids

# ElevenLabs (only if TTS_PROVIDER=elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# 1.0 = unchanged; 1.1–1.2 makes a voice more cartoon-like
VOICE_PITCH=1.0

# --- YouTube (OAuth client type "Desktop app") ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# schedule = private now, goes public at PUBLISH_TIME after PUBLISH_DELAY_DAYS (review window)
# private  = you publish by hand in YouTube Studio
# public   = public immediately
UPLOAD_MODE=schedule
PUBLISH_TIME=15:00
PUBLISH_UTC_OFFSET=5
PUBLISH_DELAY_DAYS=0

# --- Local tools (only if not on PATH) ---
# RHUBARB_PATH=/path/to/rhubarb
# CHROME_PATH=
