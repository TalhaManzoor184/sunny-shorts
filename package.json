{
  "name": "sunny-shorts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily YouTube Shorts pipeline for Sunny the Dancing Star",
  "scripts": {
    "studio": "remotion studio src/remotion/index.ts",
    "episode": "tsx src/pipeline/run.ts",
    "episode:sample": "tsx src/pipeline/run.ts --sample --tts=espeak --no-upload",
    "auth:youtube": "tsx src/scripts/get-refresh-token.ts",
    "auth:tiktok": "tsx src/scripts/tiktok-auth.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@fontsource/fredoka": "5.1.0",
    "@google/genai": "2.28.0",
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "dotenv": "16.4.5",
    "googleapis": "186.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.530",
    "zod": "3.25.76"
  }
}
